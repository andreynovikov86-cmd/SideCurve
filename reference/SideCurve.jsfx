desc:SideCurve (Sidechain Shaper)
// @description SideCurve (Sidechain Shaper)
// @version 0.4.5
// @author Andrey Novikov
// @license MIT
// Standalone REAPER JSFX: audio and native interface in one file.
tags:dynamics sidechain volume
options:gfx_hz=60 gfx_idle
in_pin:Main L
in_pin:Main R
in_pin:Sidechain L
in_pin:Sidechain R
out_pin:Main L
out_pin:Main R
slider1:0<0,1,1{Grid,Audio}>-Mode
slider2:3<0,7,1{2/1,1/1,1/2,1/4,1/8,1/16,1/32,1/64}>-Length
slider3:0<0,0,1>-Reserved
slider4:100<0,100,0.1>-Mix (%)
slider5:-30<-60,0,0.1>-Threshold (dB)
slider6:25<10,20000,1>-Detector high pass (Hz)
slider7:180<10,20000,1>-Detector low pass (Hz)
slider8:25<1,250,1>-Retrigger guard (ms)
slider9:0<0,1,1{Off,On}>-Listen to detector
slider10:0<0,1,1>-Invert envelope vertically
slider11:0.02<0,0.997,0.0001>-First point time
slider12:0<0,1,0.001>-P1 level
slider13:0.1856842105263158<0,1,0.001>-P2 time
slider14:0<0,1,0.001>-P2 level
slider15:0.34<0,1,0.001>-Reserved curvature time
slider16:0.15<0.02,0.98,0.001>-Transition curvature
slider17:0<0,0,1>-Reserved point slot A
slider18:0<0,0,1>-Reserved point slot B
slider19:0.5157894736842106<0,1,0.001>-P4 time
slider20:1<0,1,0.001>-P4 level
slider21:0.97<0.003,1,0.0001>-Last point time
slider22:1<0,1,0.001>-P5 level
slider23:0<0,2147483647,1>-Reserved legacy slot
slider24:0<0,0,1>-Reserved
slider25:1<1,1,1>-Reserved

@init
#resource_root = ""; // Configured by Install SideKick.lua; no script runs with the effect.
ext_tail_size = -1;
gfx_ext_retina==0 ? gfx_ext_retina=1;
ui_visible=0;
coeffs=3072; left_state=3200; right_state=3232;
ext_gr_meter = 0;
gain = 1;
seam_on=0;
phase = 1;
active = 0;
armed = 1;
cooldown = 0;
hits = 0;
cycle = 1;
last_bin = -1;
last_mode = -1;
px = 0; py = 16;
wave = 128; scwave = 384; stamps = 640;
hit_times=1024; hit_beats=1040; hit_ids=1056;

// Every anchor has a horizontal tangent. The middle handle controls the
// whole transition's rational bend; it never inserts a new spline knot.
function fraction(u)(u-floor(u));
function soften(u)(u*u*(3-2*u));
function curve_at(p a av b bv first last curvature) local(u k)
(
  p<=a ? (u=soften(min(1,max(0,p/max(.000001,a))));first+(av-first)*u;) :
  p>=b ? (u=soften(min(1,max(0,(p-b)/max(.000001,1-b))));bv+(last-bv)*u;) : (
    u=soften(min(1,max(0,(p-a)/max(.000001,b-a))));
    k=(1-curvature)/curvature;u=u/(k+(1-k)*u);
    av+(bv-av)*u;
  );
);
function start_seam()
(
  seam_from=gain;
  seam_pos=0;
  seam_on=1;
);
// The outer anchors delimit the editable core. In GRID, a cosine join
// connects the last anchor to the first across the period boundary.
function edge_start()(min(.997,max(0,slider11)));
function edge_end()(min(1,max(edge_start()+.003,slider21)));
function periodic_at(p a av b bv first last curvature start finish) local(u gap)
(
  p>=start && p<=finish ?
    curve_at((p-start)/(finish-start),a,av,b,bv,first,last,curvature) : (
      gap=1-finish+start;
      u=gap>.0000001 ? (p>finish ? p-finish : 1-finish+p)/gap : 1;
      u=.5-.5*cos($pi*min(1,max(0,u)));
      last+(first-last)*u;
    );
);
function shape(p) local(start finish pos v)
(
  start=edge_start();finish=edge_end();
  slider1==1 ? (
    p>=1 ? pos=-1 : (pos=finish+p;pos-=floor(pos););
  ) : pos=p;
  v=pos<0 ? py[4] : periodic_at(pos,px[1],py[1],px[3],py[3],py[0],py[4],bend,start,finish);
  slider10>=.5 ? 1-v : v;
);

// Eighth-order Butterworth edges: four biquads each, 48 dB/octave.
// RBJ low/high-pass coefficients: https://www.w3.org/TR/audio-eq-cookbook/
// Independent stereo states preserve opposite-polarity sidechain signals.
function make_edge(freq high offset) local(i q w co al norm c)
(
  w=2*$pi*min(max(10,freq),srate*.45)/srate;
  co=cos(w); i=0;
  loop(4,
    q=1/(2*cos((2*i+1)*$pi/16));
    al=sin(w)/(2*q);norm=1/(1+al);c=coeffs+offset+i*5;
    high ? (c[0]=(1+co)*.5*norm;c[1]=-(1+co)*norm;) :
           (c[0]=(1-co)*.5*norm;c[1]=(1-co)*norm;);
    c[2]=c[0];c[3]=-2*co*norm;c[4]=(1-al)*norm;
    i+=1;
  );
);
function filter(v state) local(i c z out)
(
  i=0;
  loop(8,
    c=coeffs+i*5;z=state+i*2;
    out=c[0]*v+z[0];
    z[0]=c[1]*v-c[3]*out+z[1];
    z[1]=c[2]*v-c[4]*out;
    v=out;i+=1;
  );
  v;
);

function update_controls()
(
depth = min(1,max(0,slider4*0.01));
threshold = 10^(slider5/20);
// Recompute only when an edge or sample rate changes.
old_hp!=slider6 || old_lp!=slider7 || old_sr!=srate ? (
  make_edge(slider6,1,0);make_edge(max(slider6+1,slider7),0,20);
  old_hp=slider6;old_lp=slider7;old_sr=srate;
);
release = exp(-1/(srate*0.008));
slew = 1-exp(-1/(srate*0.0007));
join_fraction=max(0,1-edge_end()+edge_start());
display_end=edge_end();
seam_samples=max(1,floor(srate*60*(8/(2^floor(slider2)))/max(1,tempo)*
  (slider1==1 ? join_fraction : edge_start())));
audition_slew = 1-exp(-1/(srate*0.005));
guard_samples = max(1,slider8*srate*0.001);
px[0]=0; py[0]=min(1,max(0,slider12));
px[1]=min(.997,max(.001,slider13)); py[1]=min(1,max(0,slider14));
px[3]=min(.999,max(px[1]+.002,slider19)); py[3]=min(1,max(0,slider20));
bend=min(.98,max(.02,slider16));
px[2]=(px[1]+px[3])*.5;py[2]=py[1]+(py[3]-py[1])*bend;
px[4]=1; py[4]=min(1,max(0,slider22));

);

@slider
update_controls();

@block
update_controls();
dur_beats = 8/(2^floor(slider2));
phase_step = max(1,tempo)/(60*srate*dur_beats);
playing = play_state&1;
slider1 != last_mode || (playing && !was_playing) ? (
  active=0; phase=1; detector=0; armed=1; cooldown=0;
  cycle+=1; memset(left_state,0,16);memset(right_state,0,16);
  start_seam();
);
slider1 == 0 ? (
  grid_pos = beat_position/dur_beats;
  next_phase = grid_pos-floor(grid_pos);
  abs(next_phase-phase)>0.15 ? (cycle+=1;start_seam(););
  phase = next_phase;
);
last_mode=slider1; was_playing=playing;
block_offset=0;
ext_gr_meter = 20*log10(max(0.000001,gain));

// UI-independent audio state. Audition belongs to the visible native window.
listen_value=slider9 && ui_visible && slider1==1;

@sample
sc_l=filter(spl2,left_state);sc_r=filter(spl3,right_state);
peak=max(abs(sc_l),abs(sc_r));
detector=max(peak,detector*release);
cooldown=max(0,cooldown-1);
// Hysteresis rearms after the tail has fallen below -6 dB relative to threshold.
// A new above-threshold attack always restarts, even during an active curve.
detector < threshold*0.5 ? armed=1;
slider1==1 && armed && cooldown<=0 && peak>=threshold ? (
  phase=0; active=1; armed=0; cooldown=guard_samples;
  hits+=1; cycle+=1;
  hidx=(hits-1)%16;
  hit_times[hidx]=play_position+block_offset/srate;
  hit_beats[hidx]=beat_position+block_offset*max(1,tempo)/(60*srate);
  hit_ids[hidx]=hits;
  shot_from=gain;seam_on=0;
);
target=1;
slider1==0 ? (
  playing ? target=1-depth+depth*shape(phase);
) : (
  active && join_fraction>.0000001 && phase<join_fraction ? (
    // Replay the COMPLETE outer-anchor join at each accepted attack.
    // A rapid retrigger starts from the actual current gain, not a stale endpoint.
    join_mix=.5-.5*cos($pi*phase/join_fraction);
    first_gain=1-depth+depth*(slider10>=.5 ? 1-py[0] : py[0]);
    target=shot_from+(first_gain-shot_from)*join_mix;
  ) : target=1-depth+depth*shape(active ? phase : 1);
);
// Retrigger from actual gain; the first anchor sets the fade duration.
// Raised-cosine endpoints have zero slope; rapid retriggers start from the
// current gain rather than jumping to a previous cycle's endpoint.
seam_on ? (
  seam_mix=.5-.5*cos($pi*min(1,seam_pos/seam_samples));
  target=seam_from+(target-seam_from)*seam_mix;
  seam_pos+=1;
  seam_pos>seam_samples ? seam_on=0;
);
gain += slew*(target-gain);
audition += audition_slew*(listen_value-audition);
out_l=spl0*gain; out_r=spl1*gain;
wave_phase=slider1==1 ? (active ? fraction(display_end+phase) : display_end) : phase;
idx=min(255,max(0,floor(wave_phase*256)));
stamps[idx]!=cycle ? (wave[idx]=0; scwave[idx]=0; stamps[idx]=cycle;);
wave[idx]=max(wave[idx],max(abs(out_l),abs(out_r)));
scwave[idx]=max(scwave[idx],peak);
spl0=out_l*(1-audition)+sc_l*audition;
spl1=out_r*(1-audition)+sc_r*audition;
slider1==0 ? (
  playing ? (
    phase+=phase_step;
    phase>=1 ? (phase-=floor(phase);cycle+=1;);
  );
) : active ? (
  phase+=phase_step;
  phase>=1 ? (phase=1;active=0;);
);
block_offset+=1;

@gfx 698 478
// Native vector interface. Only the audio thread owns DSP point/filter state.
function color(rgb alpha)
(
  gfx_set(((rgb>>16)&255)/255,((rgb>>8)&255)/255,(rgb&255)/255,alpha);
);
function rect(x y w h rgb)
(
  color(rgb,1);gfx_rect(x*us,y*us,w*us,h*us);
);
// Pixel-aligned filled capsules. End caps and straight section have exactly
// the same height; AA circles previously made JSFX rail ends bulge by a pixel.
function roundbox(x y w h r rgb) local(l top ww hh rr row dy inset cut aa)
(
  l=floor(x*us+.5);top=floor(y*us+.5);
  ww=max(1,floor(w*us+.5));hh=max(1,floor(h*us+.5));
  rr=min(r*us,min(ww,hh)*.5);row=0;
  loop(hh,
    dy=max(0,max(rr-row-.5,row+.5-(hh-rr)));
    inset=rr-sqrt(max(0,rr*rr-dy*dy));cut=ceil(inset);aa=cut-inset;
    color(rgb,1);gfx_rect(l+cut,top+row,max(0,ww-2*cut),1);
    aa>0 ? (color(rgb,aa);gfx_rect(l+cut-1,top+row,1,1);gfx_rect(l+ww-cut,top+row,1,1););
    row+=1;
  );
);
function line(x y xx yy rgb alpha)
(
  color(rgb,alpha);gfx_line(x*us,y*us,xx*us,yy*us,1);
);
function stroke(x y xx yy width rgb) local(dx dy mag nx ny)
(
  dx=xx-x;dy=yy-y;mag=max(.00001,sqrt(dx*dx+dy*dy));
  nx=-dy/mag*width*.5;ny=dx/mag*width*.5;color(rgb,1);
  gfx_triangle((x+nx)*us,(y+ny)*us,(xx+nx)*us,(yy+ny)*us,(xx-nx)*us,(yy-ny)*us,(x-nx)*us,(y-ny)*us);
  gfx_line((x+nx)*us,(y+ny)*us,(xx+nx)*us,(yy+ny)*us,1);
  gfx_line((x-nx)*us,(y-ny)*us,(xx-nx)*us,(yy-ny)*us,1);
);
function label(x y txt size rgb)
(
  color(rgb,1);gfx_setfont(1,"Arial",max(9,size*us),98);
  gfx_x=x*us;gfx_y=y*us;gfx_drawstr(txt);
);
function centered(x y w h txt size rgb)
(
  color(rgb,1);gfx_setfont(1,"Arial",max(9,size*us),98);
  gfx_x=x*us;gfx_y=y*us;gfx_drawstr(txt,5,(x+w)*us,(y+h)*us);
);
function right_label(x y w h txt size rgb)
(
  color(rgb,1);gfx_setfont(1,"Arial",max(9,size*us),98);
  gfx_x=x*us;gfx_y=y*us;gfx_drawstr(txt,6,(x+w)*us,(y+h)*us);
);
function inside(x y w h)(mx>=x && mx<x+w && my>=y && my<y+h);
function put(param val) local(mask)
(
  slider(param)=val;mask=2^(param-1);touch_mask|=mask;
  sliderchange(mask);slider_automate(mask);
);
function factory_reset()
(
  // Same parameter values as REAPER's "Reset to factory default" command.
  put(1,0);
  put(2,3);
  put(3,0);
  put(4,100);
  put(5,-30);
  put(6,25);
  put(7,180);
  put(8,25);
  put(9,0);
  put(10,0);
  put(11,0.02);
  put(12,0);
  put(13,0.1856842105263158);
  put(14,0);
  put(15,0.34);
  put(16,0.15);
  put(17,0);
  put(18,0);
  put(19,0.5157894736842106);
  put(20,1);
  put(21,0.97);
  put(22,1);
  put(23,0);
  put(24,0);
  put(25,1);
);
// REAPER stores the user's default by preset name, independently of factory
// values. Read only our own mapping and preset file, on an explicit RESET click.
function trim_line(str) local(n c)
(
  n=strlen(str);
  while(n>0 && ((c=str_getchar(str,n-1))==10 || c==13))(n-=1;);
  str_setlen(str,n);
);
function hex_digit(c)
(
  c>=48 && c<=57 ? c-48 : c>=65 && c<=70 ? c-55 : c>=97 && c<=102 ? c-87 : -1;
);
function apply_preset_data(data) local(i n a b j k value ok)
(
  strcpy(#decoded,"");i=0;n=strlen(data);ok=n>2 && n<16384;
  while(ok && i+1<n-2)(
    a=hex_digit(str_getchar(data,i));b=hex_digit(str_getchar(data,i+1));
    a<0 || b<0 ? ok=0 : str_setchar(#decoded,strlen(#decoded),a*16+b);
    i+=2;
  );
  // Stage all sliders before touching the live parameters.
  i=0;j=0;n=strlen(#decoded);
  while(ok && j<25)(
    while(i<n && str_getchar(#decoded,i)==32)(i+=1;);
    k=i;while(i<n && str_getchar(#decoded,i)!=32)(i+=1;);
    strcpy_substr(#token,#decoded,k,i-k);
    match("%f",#token,value) ? (12000[j]=value;j+=1;) : ok=0;
  );
  ok && j==25 ? (j=0;loop(25,put(j+1,12000[j]);j+=1;);1;) : 0;
);
function user_default() local(h section found loaded)
(
  loaded=0;
  strlen(#resource_root)>0 ? (
    sprintf(#path,"%s/reaper-defpresets.ini",#resource_root);h=file_open(#path);
    strcpy(#default_name,"");section=0;
    h>=0 ? (
      while(file_avail(h)>0)(
        file_string(h,#ini_line);trim_line(#ini_line);
        str_getchar(#ini_line,0)==91 ? section=!strcmp(#ini_line,"[defaultpresets]");
        section && (match("js-SideKick/SideKick.jsfx=%s",#ini_line,#default_name) ||
          match("js-SideKick\\SideKick.jsfx=%s",#ini_line,#default_name));
      );
      file_close(h);
    );
    strlen(#default_name)>0 ? (
      sprintf(#path,"%s/presets/js-SideKick_SideKick_jsfx.ini",#resource_root);h=file_open(#path);
      h>=0 ? (
        strcpy(#preset_name,"");strcpy(#preset_data,"");section=0;
        while(file_avail(h)>0 && !loaded)(
          file_string(h,#ini_line);trim_line(#ini_line);
          str_getchar(#ini_line,0)==91 ? (
            section && !strcmp(#preset_name,#default_name) ? loaded=apply_preset_data(#preset_data);
            section=match("[Preset%d]",#ini_line,found);
            strcpy(#preset_name,"");strcpy(#preset_data,"");
          ) : section ? (
            match("Name=%s",#ini_line,#preset_name);
            match("Data=%s",#ini_line,#preset_data);
          );
        );
        !loaded && section && !strcmp(#preset_name,#default_name) ? loaded=apply_preset_data(#preset_data);
        file_close(h);
      );
    );
  );
  loaded;
);
function reset_shape()
(
  user_default() ? 1 : factory_reset();
);
function button(x y w h txt selected) local(bgc)
(
  bgc=selected ? ui_selected : inside(x,y,w,h) ? 0x464646 : 0x3B3B3B;
  roundbox(x,y,w,h,7,bgc);
  centered(x,y,w,h,txt,15,ui_text);
  pressed && inside(x,y,w,h);
);
// Approved AN mark: identical outlines to the native SVG asset.
function brand_mark(x y h rgb)
(
  color(rgb,1);
  gfx_triangle((x+0.5751295*h)*us,(y+0.1761658*h)*us,(x+0.6943005*h)*us,(y+0.0000000*h)*us,(x+1.1606218*h)*us,(y+0.0000000*h)*us,(x+1.1606218*h)*us,(y+0.0000000*h)*us);
  gfx_triangle((x+0.5751295*h)*us,(y+0.1761658*h)*us,(x+1.1606218*h)*us,(y+0.0000000*h)*us,(x+1.2642487*h)*us,(y+0.2020725*h)*us,(x+1.2642487*h)*us,(y+0.2020725*h)*us);
  gfx_triangle((x+1.2642487*h)*us,(y+0.2020725*h)*us,(x+1.3005181*h)*us,(y+0.2538860*h)*us,(x+1.3316062*h)*us,(y+0.3264249*h)*us,(x+1.3316062*h)*us,(y+0.3264249*h)*us);
  gfx_triangle((x+1.3316062*h)*us,(y+0.3264249*h)*us,(x+1.3678756*h)*us,(y+0.3782383*h)*us,(x+1.3937824*h)*us,(y+0.4404145*h)*us,(x+1.3937824*h)*us,(y+0.4404145*h)*us);
  gfx_triangle((x+1.4196891*h)*us,(y+0.4041451*h)*us,(x+1.5699482*h)*us,(y+0.0000000*h)*us,(x+1.8756477*h)*us,(y+0.0000000*h)*us,(x+1.8756477*h)*us,(y+0.0000000*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.4196891*h)*us,(y+0.4041451*h)*us,(x+1.8756477*h)*us,(y+0.0000000*h)*us,(x+1.8756477*h)*us,(y+0.0000000*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.8756477*h)*us,(y+0.0000000*h)*us,(x+1.8652850*h)*us,(y+0.0466321*h)*us,(x+1.8652850*h)*us,(y+0.0466321*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.8652850*h)*us,(y+0.0466321*h)*us,(x+1.8082902*h)*us,(y+0.1709845*h)*us,(x+1.8082902*h)*us,(y+0.1709845*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.8082902*h)*us,(y+0.1709845*h)*us,(x+1.8031088*h)*us,(y+0.2020725*h)*us,(x+1.8031088*h)*us,(y+0.2020725*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.8031088*h)*us,(y+0.2020725*h)*us,(x+1.7720207*h)*us,(y+0.2642487*h)*us,(x+1.7720207*h)*us,(y+0.2642487*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.7720207*h)*us,(y+0.2642487*h)*us,(x+1.7668394*h)*us,(y+0.2953368*h)*us,(x+1.7668394*h)*us,(y+0.2953368*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.7668394*h)*us,(y+0.2953368*h)*us,(x+1.7253886*h)*us,(y+0.3834197*h)*us,(x+1.7253886*h)*us,(y+0.3834197*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.7253886*h)*us,(y+0.3834197*h)*us,(x+1.7202073*h)*us,(y+0.4145078*h)*us,(x+1.7202073*h)*us,(y+0.4145078*h)*us);
  gfx_triangle((x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.7202073*h)*us,(y+0.4145078*h)*us,(x+1.6994819*h)*us,(y+0.4507772*h)*us,(x+1.6994819*h)*us,(y+0.4507772*h)*us);
  gfx_triangle((x+1.3937824*h)*us,(y+0.4404145*h)*us,(x+1.4041451*h)*us,(y+0.4404145*h)*us,(x+1.6994819*h)*us,(y+0.4507772*h)*us,(x+1.6994819*h)*us,(y+0.4507772*h)*us);
  gfx_triangle((x+1.3937824*h)*us,(y+0.4404145*h)*us,(x+1.6994819*h)*us,(y+0.4507772*h)*us,(x+1.6943005*h)*us,(y+0.4818653*h)*us,(x+1.6943005*h)*us,(y+0.4818653*h)*us);
  gfx_triangle((x+1.3937824*h)*us,(y+0.4404145*h)*us,(x+1.6943005*h)*us,(y+0.4818653*h)*us,(x+1.6735751*h)*us,(y+0.5181347*h)*us,(x+1.6735751*h)*us,(y+0.5181347*h)*us);
