function signature_label(x y txt size rgb)
(
  color(rgb,1);gfx_setfont(2,"Arial",max(9,size*us),0);
  gfx_x=x*us;gfx_y=y*us;gfx_drawstr(txt);
);
// Cache the AN mark and two-line title at 4x the UI scale.
function branding(x y) local(saved_us saved_dest pixels height)
(
  saved_us=us;saved_dest=gfx_dest;pixels=max(216,ceil(216*us*4));height=ceil(46*pixels/216);
  brand_pixels!=pixels ? (
    brand_pixels=pixels;gfx_setimgdim(1,pixels,height);gfx_dest=1;us=pixels/216;
    rect(0,0,216,46,ui_bg);
    brand_mark(0,6,32,ui_text);
    label(72,3,"SideCurve",26,ui_text);
    signature_label(72,25,"by Andrey Novikov",14,0xC6C6C6);
  );
  us=saved_us;gfx_dest=saved_dest;
  gfx_blit(1,1,0,0,0,pixels,height,x*us,y*us,216*us,46*us);
);
function knob_vector(cx cy mix) local(i aa row rows fy half shade face_color)
(
  color(0x242424,1);gfx_circle(cx*us,(cy+1)*us,48*us,1,1);
  color(0x363636,1);gfx_circle(cx*us,cy*us,48*us,1,1);
  row=0;rows=max(1,ceil(96*us));
  loop(rows,
    fy=-48+(row+.5)/us;half=sqrt(max(0,48*48-fy*fy));
    shade=floor(66-12*row/rows);face_color=shade*65793;
    color(face_color,1);gfx_rect((cx-half)*us,(cy+fy)*us,half*2*us,1);
    row+=1;
  );
  i=0;loop(481,
    aa=$pi*.75+$pi*1.5*i/480;
    color(mix>0 && i/480<=mix ? ui_accent : ui_rail,1);
    gfx_circle((cx+cos(aa)*55)*us,(cy+sin(aa)*55)*us,3.25*us,1,1);
    i+=1;
  );
  aa=$pi*.75+$pi*1.5*mix;
  color(0xF1EFE9,1);gfx_circle((cx+cos(aa)*48*.84)*us,(cy+sin(aa)*48*.84)*us,3.6*us,1,1);
);
function knob_art(x y mix) local(saved_us saved_dest pixels)
(
  saved_us=us;saved_dest=gfx_dest;pixels=max(128,ceil(122*us*3));
  knob_pixels!=pixels || knob_mix!=mix || !knob_cached ? (
    knob_pixels=pixels;knob_mix=mix;knob_cached=1;
    gfx_setimgdim(0,pixels,pixels);gfx_dest=0;us=pixels/122;
    rect(0,0,122,122,ui_bg);knob_vector(61,61,mix);
  );
  us=saved_us;gfx_dest=saved_dest;
  gfx_blit(0,1,0,0,0,pixels,pixels,(x-61)*us,(y-61)*us,122*us,122*us);
);
function read_points() local(j start finish)
(
  start=edge_start();finish=edge_end();uspan=finish-start;
  ux[0]=start;uy[0]=slider12;
  ux[1]=start+min(.997,max(.001,slider13))*uspan;uy[1]=slider14;
  ux[3]=start+min(.999,max(slider13+.002,slider19))*uspan;uy[3]=slider20;
  ux[4]=finish;uy[4]=slider22;ubend=slider16;
  slider10>=.5 ? (j=0;loop(5,uy[j]=1-uy[j];j+=1;););
  uwrap=ux[0];
  ux[2]=(ux[1]+ux[3])*.5;uy[2]=uy[1]+(uy[3]-uy[1])*ubend;
);
function ui_curve(p) local(v)
(
  v=periodic_at(p,min(.997,max(.001,slider13)),slider14,
    min(.999,max(slider13+.002,slider19)),slider20,
    slider12,slider22,min(.98,max(.02,slider16)),edge_start(),edge_end());
  slider10>=.5 ? 1-v : v;
);
// Move an outer anchor while keeping the inner anchors at their absolute times.
function move_edge(index t) local(start finish a b span)
(
  start=edge_start();finish=edge_end();span=finish-start;
  a=start+min(.997,max(.001,slider13))*span;
  b=start+min(.999,max(slider13+.002,slider19))*span;
  index==0 ? start=min(a-.001,max(0,t)) : finish=max(b+.001,min(1,t));
  span=max(.003,finish-start);
  put(11,start);put(21,finish);
  put(13,min(.997,max(.001,(a-start)/span)));
  put(19,min(.999,max(slider13+.002,(b-start)/span)));
);
function move_point(index t v) local(norm)
(
  slider10>=.5 ? v=1-v;
  index==0 || index==4 ? move_edge(index,t);
  t=(t-edge_start())/(edge_end()-edge_start());
  index==0 ? put(12,v);
  index==4 ? put(22,v);
  index==1 ? (put(13,min(slider19-.002,max(.001,t)));put(14,v););
  index==3 ? (put(19,min(.999,max(slider13+.002,t)));put(20,v););
  index==2 && abs(slider20-slider14)>.0001 ? (
    norm=min(.98,max(.02,(v-slider14)/(slider20-slider14)));
    put(16,norm);
  );
);
function slide_transition(offset a b) local(shift span)
(
  span=edge_end()-edge_start();
  shift=min(.999-b,max(.001-a,offset/span));
  put(13,a+shift);put(19,b+shift);
);
function lift_section(tail offset a b) local(shift)
(
  slider10>=.5 ? (a=1-a;b=1-b;);
  shift=min(1-max(a,b),max(-min(a,b),offset));
  a+=shift;b+=shift;
  slider10>=.5 ? (a=1-a;b=1-b;);
  tail ? (put(20,a);put(22,b);) : (put(12,a);put(14,b););
);
function snap_transition() local(first last a b da db score best left right)
(
  first=ceil((uwrap+.001*uspan-.0000000001)/grid_step);
  last=floor((uwrap+.999*uspan+.0000000001)/grid_step);
  best=1000000;left=-1;right=-1;a=first;
  loop(max(0,last-first+1),
    b=a+1;
    loop(max(0,last-a),
      (b-a)*grid_step>=.002*uspan ? (
        da=a*grid_step-ux[1];db=b*grid_step-ux[3];score=da*da+db*db;
        score<best ? (best=score;left=a;right=b;);
      );b+=1;
    );a+=1;
  );
  left>=0 ? (
    put(13,(left*grid_step-uwrap)/uspan);put(19,(right*grid_step-uwrap)/uspan);
  );
);
function nearest_grid(t lo hi) local(first last)
(
  first=ceil((lo-.0000000001)/grid_step);last=floor((hi+.0000000001)/grid_step);
  first<=last ? min(last,max(first,floor(t/grid_step+.5)))*grid_step : t;
);
function snap_point(index) local(lo hi target span)
(
  read_points();span=uspan;lo=0;hi=1;
  index==0 ? hi=ux[1]-.001;
  index==4 ? lo=ux[3]+.001;
  index==1 ? (lo=uwrap+.001*span;hi=ux[3]-.002*span;);
  index==3 ? (lo=ux[1]+.002*span;hi=uwrap+.999*span;);
  index==2 ? (
    snap_transition();
  ) : move_point(index,nearest_grid(ux[index],lo,hi),uy[index]);
);
function fader(x y w title val minimum maximum param unit) local(f)
(
  label(x,y,title,15,slider1==1 ? ui_text : ui_disabled);
  sprintf(#fv,"%.0f %s",val,unit);right_label(x+w-76,y-1,76,23,#fv,15,slider1==1 ? ui_text : ui_disabled);
  roundbox(x,y+32,w,8,4,ui_rail);
  f=(val-minimum)/(maximum-minimum);
  roundbox(x,y+32,max(8,w*f),8,4,slider1==1 ? ui_accent : 0x4B4B4B);
  color(slider1==1 ? ui_accent : ui_disabled,1);gfx_circle((x+f*w)*us,(y+36)*us,7*us,1,1);
  pressed && slider1==1 && inside(x-6,y+24,w+12,24) ? drag=param;
  drag==param && down && slider1==1 ? put(param,minimum+(maximum-minimum)*min(1,max(0,(mx-x)/w)));
);

// gfx_idle sends a closed-window callback. Listening must not remain on then.
gfx_ext_flags&2 ? (
  ui_visible=0;
  slider9 ? (slider9=0;sliderchange(256);slider_automate(256););
) : (
  ui_visible=1;
  !channels_checked ? (set_host_numchan(max(4,get_host_numchan()));channels_checked=1;);
  gfx_getchar();
  us=max(.1,min(gfx_w/820,gfx_h/600));uw=gfx_w/us;uh=gfx_h/us;
  ux=2048;uy=2064;
  mx=mouse_x/us;my=mouse_y/us;down=mouse_cap&1;
  pressed=down && !last_down;released=!down && last_down;
  now=time_precise();
  // Shared palette: every active purple element uses this exact hue.
  ui_bg=0x303030;ui_plot=0x242424;ui_text=0xD5D5D5;ui_muted=0xA0A0A0;
  ui_accent=0xAF85FF;ui_selected=0x594770;ui_disabled=0x686868;ui_rail=0x484848;
  rect(0,0,uw,uh,ui_bg);
  button(20,18,88,30,"GRID",slider1==0) ? put(1,0);
  button(116,18,88,30,"AUDIO",slider1==1) ? put(1,1);
  brand_x=uw*.5-104.5;branding(brand_x,10);
  slider1==0 && slider9 ? put(9,0);
  button(uw-204,18,88,30,"INVERT",slider10) ? put(10,!slider10);
  button(uw-108,18,88,30,"RESET",0) ? reset_shape();

  gx=20;gy=65;gw=uw-40;gh=uh-260;
  roundbox(gx,gy,gw,gh,9,ui_plot);
  pl=gx+49;pt=gy+27;pw=gw-68;ph=gh-55;
  udur=8/(2^floor(slider2));
  // Display musical beats; short cycles are subdivided into equal beat parts.
  grid_step=(4/max(1,ts_denom))/udur;
  while(grid_step*pw>120)(grid_step*=.5;);
  while(grid_step*pw<38)(grid_step*=2;);
  read_points();
  i=0;loop(5,
    yy=pt+ph*i/4;
    line(pl,yy,pl+pw,yy,0x414141,.8);
    sprintf(#percent,"%d%%",100-i*25);label(gx+6,yy-10,#percent,14,ui_muted);
    i+=1;
  );
  grid_i=0;
  loop(min(128,ceil(1/grid_step)+1),
    tt=min(1,grid_i*grid_step);xx=pl+tt*pw;
    line(xx,pt,xx,pt+ph,0x414141,.65);
    grid_i+=1;
  );
  // Relative musical length: half the selected duration at the center.
  li=floor(slider2);
  li==0 ? #half_length="1/1" : sprintf(#half_length,"1/%d",2^li);
  li==0 ? #full_length="2/1" : sprintf(#full_length,"1/%d",2^(li-1));
  centered(pl+pw*.5-50,pt+ph+5,100,28,#half_length,15,ui_text);
  centered(pl+pw-45,pt+ph+5,90,28,#full_length,15,ui_text);

  // Real post-gain program audio and filtered input 3/4, phase-aligned.
  i=0;mid=pt+ph*.5;
  loop(256,
    stamps[i]>=cycle-1 && stamps[i]>0 ? (
      xx=pl+(i+.5)*pw/256;
      amp=sqrt(min(1,max(0,wave[i])))*ph*.45;
      line(xx,mid-amp,xx,mid+amp,0xA2A2A7,.44);
      slider1==1 ? (
        amp=sqrt(min(1,max(0,scwave[i])))*ph*.45;
        line(xx,mid-amp,xx,mid+amp,ui_accent,.48);
      );
    );i+=1;
  );
  // Reveal the transition region only while the pointer is over that region.
  plot_hover=inside(pl+ux[1]*pw,pt,(ux[3]-ux[1])*pw,ph);
  plot_hover ? (
    color(ui_accent,.07);gfx_rect((pl+ux[1]*pw)*us,pt*us,(ux[3]-ux[1])*pw*us,ph*us);
    i=0;loop(ceil(ph/9),
      yy=pt+i*9;
      line(pl+ux[1]*pw,yy,pl+ux[1]*pw,min(pt+ph,yy+5),ui_accent,.43);
      line(pl+ux[3]*pw,yy,pl+ux[3]*pw,min(pt+ph,yy+5),ui_accent,.43);
      i+=1;
    );
  );
  // Graph sampling uses the same mathematical curve as the audio processor.
  steps=max(256,ceil(pw*us));i=0;
  ox=pl;oy=pt+ph*(1-ui_curve(0));
  loop(steps,
    pp=(i+1)/steps;xx=pl+pp*pw;yy=pt+ph*(1-ui_curve(pp));
    stroke(ox,oy,xx,yy,3.2,ui_accent);
    ox=xx;oy=yy;i+=1;
  );
  (slider1==0 && playing || slider1==1 && active) ?
    line(pl+(slider1==1 ? fraction(ux[4]+phase) : phase)*pw,pt,
         pl+(slider1==1 ? fraction(ux[4]+phase) : phase)*pw,pt+ph,0xE1DFE6,.55);
  nearest=-1;dist=14*14;i=0;
  loop(5,
    xx=pl+ux[i]*pw;yy=pt+ph*(1-uy[i]);
    dd=(mx-xx)^2+(my-yy)^2;
    dd<dist ? (dist=dd;nearest=i;);
    color(ui_accent,1);gfx_circle(xx*us,yy*us,6.4*us,1,1);
    color(ui_plot,1);gfx_circle(xx*us,yy*us,2.8*us,1,1);
    i+=1;
  );
  pressed && nearest>=0 ? (
    now-last_click<.32 && last_point==nearest ? (
      snap_point(nearest);drag=0;last_click=0;
    ) : (drag=30+nearest;last_click=now;last_point=nearest;);
  );
  pressed && nearest<0 && inside(pl+ux[1]*pw,pt,(ux[3]-ux[1])*pw,ph) ? (
    drag=27;region_down_x=mx;region_a=slider13;region_b=slider19;
  );
  section_t=(mx-pl)/pw;
  section_head=section_t>ux[0] && section_t<ux[1];
  section_tail=section_t>ux[3] && section_t<ux[4];
  pressed && nearest<0 && (section_head || section_tail) && abs(my-(pt+ph*(1-ui_curve(section_t))))<=10 ? (
    drag=section_tail ? 29 : 28;section_down_y=my;
    section_a=section_tail ? slider20 : slider12;section_b=section_tail ? slider22 : slider14;
  );
  down && (drag==28 || drag==29) ? lift_section(drag==29,(section_down_y-my)/ph,section_a,section_b);
  down && drag==27 ? slide_transition((mx-region_down_x)/pw,region_a,region_b);
  down && drag>=30 && drag<=34 ? (
    move_point(drag-30,min(1,max(0,(mx-pl)/pw)),min(1,max(0,1-(my-pt)/ph)));
  );

  by=gy+gh+18;
  // One clean face, thick accent arc, inset white dot; no ornamental rings.
  kx=100;ky=by+78;kr=48;arc_radius=55;
  knob_hit=(mx-kx)^2+(my-ky)^2<=(arc_radius+5)^2;
  pressed && knob_hit ? (
    now-last_knob_click<.32 ? put(4,100);
    drag=4;drag_y=my;drag_v=slider4;last_knob_click=now;
  );
  drag==4 && down ? put(4,min(100,max(0,drag_v+(drag_y-my)*(mouse_cap&8 ? .0704 : .44))));
  knob_hit && mouse_wheel ? put(4,min(100,max(0,slider4+mouse_wheel/120)));
  knob_art(kx,ky,min(1,max(0,slider4*.01)));
  mix_readout=drag==4 && down;
  mix_readout ? (sprintf(#mix_value,"%.0f%%",slider4);centered(kx-31,ky-13,62,26,#mix_value,15,ui_text););
  centered(kx-45,by+129,90,24,"MIX",15,ui_text);

  li=floor(slider2);li==0 ? #length="2/1" : sprintf(#length,"1/%d",2^(li-1));
  button(168,by+7,48,28,#length,0) ? (
    gfx_x=168*us;gfx_y=(by+35)*us;
    choice=gfx_showmenu("2/1|1/1|1/2|1/4|1/8|1/16|1/32|1/64");
    choice>0 ? put(2,choice-1);
  );

  // Small audition button aligned with the FILTER and TRIGGER labels.
  fx=242;right_x=uw-230;fw=right_x-24-fx;
  hx=fx+fw-18;hy=by+21;
  pressed && slider1==1 && inside(hx-18,by+7,36,28) ? put(9,!slider9);
  roundbox(hx-18,by+7,36,28,6,slider1==1 ? slider9 ? ui_selected : 0x3B3B3B : ui_bg);
  i=0;loop(32,
    aa=$pi*i/32;bb=$pi*(i+1)/32;
    stroke(hx+7*cos(aa),hy-7*sin(aa),hx+7*cos(bb),hy-7*sin(bb),2,slider1==1 ? slider9 ? ui_accent : ui_text : ui_disabled);
    i+=1;
  );
  roundbox(hx-8.5,hy-1,4,8,1.5,slider1==1 ? slider9 ? ui_accent : ui_text : ui_disabled);
  roundbox(hx+4.5,hy-1,4,8,1.5,slider1==1 ? slider9 ? ui_accent : ui_text : ui_disabled);

  label(fx,by+13,"FILTER",15,slider1==1 ? ui_text : ui_disabled);
  rail=by+53;
  hpv=log(max(10,slider6)/10)/log(2000);
  lpv=log(max(10,slider7)/10)/log(2000);
  roundbox(fx,rail-4,fw,8,4,ui_rail);
  roundbox(fx+hpv*fw,rail-4,max(2,(lpv-hpv)*fw),8,4,slider1==1 ? ui_accent : 0x4B4B4B);
  color(slider1==1 ? ui_accent : ui_disabled,1);
  gfx_circle((fx+hpv*fw)*us,rail*us,8.8*us,1,1);
  gfx_circle((fx+lpv*fw)*us,rail*us,8.8*us,1,1);
  color(ui_bg,1);
  gfx_circle((fx+hpv*fw)*us,rail*us,3.1*us,1,1);
  gfx_circle((fx+lpv*fw)*us,rail*us,3.1*us,1,1);
  pressed && slider1==1 && inside(fx-13,rail-17,fw+26,34) ? (
    mx>fx+hpv*fw+12 && mx<fx+lpv*fw-12 ? (
      drag=26;band_anchor_x=mx;band_hp=slider6;band_lp=slider7;
    ) : drag=abs(mx-(fx+hpv*fw))<=abs(mx-(fx+lpv*fw)) ? 6 : 7;
  );
  down && slider1==1 && (drag==6 || drag==7) ? (
    freq=10*2000^min(1,max(0,(mx-fx)/fw));
    drag==6 ? put(6,min(slider7/1.02,max(10,freq))) : put(7,max(slider6*1.02,min(20000,freq)));
  );
  down && slider1==1 && drag==26 ? (
    // One logarithmic offset moves both edges, preserving their frequency ratio.
    band_shift=min(log(20000/band_lp),max(log(10/band_hp),(mx-band_anchor_x)/fw*log(2000)));
    put(6,band_hp*exp(band_shift));put(7,band_lp*exp(band_shift));
  );
  // Actual reduction in muted yellow, without an extra trigger lamp.
  label(right_x,by+13,"TRIGGER",15,slider1==1 ? ui_text : ui_disabled);
  meter_level=slider1==1 ? min(1,max(0,1-gain)) : 0;
  roundbox(right_x,rail-4,188,8,4,ui_rail);
  meter_level>.001 ? roundbox(right_x,rail-4,max(5,188*meter_level),8,4,0xB3A04D);
  fader(fx,by+93,fw,"THRESHOLD",slider5,-60,0,5,"dB");
  fader(right_x,by+93,188,"RETRIGGER",slider8,1,250,8,"ms");

  !down ? (
    touch_mask ? (slider_automate(touch_mask,1);touch_mask=0;);
    drag=0;
  );
  mouse_wheel=0;last_down=down;
);
